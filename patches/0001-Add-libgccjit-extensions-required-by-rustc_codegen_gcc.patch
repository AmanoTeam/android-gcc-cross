+  r.write ("  static const unsigned char %s[%u] = {",
+	   bytes_id,
+	   m_bytes.length () ? m_bytes.length () : 1);
+  unsigned i;
+  unsigned char c;
+  FOR_EACH_VEC_ELT (m_bytes, i, c)
