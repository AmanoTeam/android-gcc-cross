From a58f73184409e6c1374f5c50966cd8e67eb5b5c7 Mon Sep 17 00:00:00 2001
From: Kartatz <105828205+Kartatz@users.noreply.github.com>
Date: Thu, 17 Sep 2026 07:36:48 +0000
Subject: [PATCH] Enable automatic linking of libandroid-stb

---
 gcc/config/linux-android.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/gcc/config/linux-android.h b/gcc/config/linux-android.h
index 01061acbd..cbb455ff6 100644
--- a/gcc/config/linux-android.h
+++ b/gcc/config/linux-android.h
@@ -111,7 +111,7 @@ extern void android_override_options(void);
   "%{mandroid-weak-symbols: -D __ANDROID_UNAVAILABLE_SYMBOLS_ARE_WEAK__} "
 
 #define ANDROID_LIB_SPEC \
-  "%{!static: -ldl}"
+  "%{!static: -ldl} -landroid-stb"
 
 #define ANDROID_STARTFILE_SPEC						\
   "%{shared: crtbegin_so%O%s;:"						\
-- 
2.55.0

