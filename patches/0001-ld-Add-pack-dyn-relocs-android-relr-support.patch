+"""Verify the Android packed relocations produced by
+ld --pack-dyn-relocs=android[+relr].
+
+Usage: pack-dyn-relocs-check.py PACKED_ELF [PLAIN_ELF]
+
+Decodes the APS2 packed relocation blob (and RELR data, if present)
+of PACKED_ELF using the same algorithm as Android's dynamic linker
+(bionic's linker) and, when PLAIN_ELF is given, checks that the
+decoded relocations match the plain REL/RELA dynamic relocations of
+PLAIN_ELF.  Exits with status 0 on success.
+"""
+
+import struct
+import sys
+
+RELOCATION_GROUPED_BY_INFO_FLAG = 1
+RELOCATION_GROUPED_BY_OFFSET_DELTA_FLAG = 2
+RELOCATION_GROUPED_BY_ADDEND_FLAG = 4
+RELOCATION_GROUP_HAS_ADDEND_FLAG = 8
+
+SHT_RELA = 4
+SHT_DYNAMIC = 6
+SHT_REL = 9
+SHT_RELR = 19
+SHT_ANDROID_REL = 0x60000001
+SHT_ANDROID_RELA = 0x60000002
+
+DT_RELA = 7
+DT_RELASZ = 8
+DT_REL = 8
+DT_RELSZ = 9
+DT_RELRSZ = 35
+DT_RELR = 36
+DT_ANDROID_REL = 0x6000000F
+DT_ANDROID_RELSZ = 0x60000010
+DT_ANDROID_RELA = 0x60000011
+DT_ANDROID_RELASZ = 0x60000012
+
+PT_LOAD = 1
+
+
+class ELF:
+    """Minimal ELF reader (ELFCLASS32/64, either byte order)."""
+
+    def __init__(self, path):
+        self.path = path
+        self.data = open(path, "rb").read()
+        if self.data[:4] != b"\x7fELF":
+            raise SystemExit("FAIL: %s: not an ELF file" % path)
+        self.is64 = self.data[4] == 2
+        self.endian = "<" if self.data[5] == 1 else ">"
+        if self.is64:
+            self.hfmt = self.endian + "HHIQQQIHHHHHH"
+            self.sfmt = self.endian + "IIQQQQIIQQ"
+            self.dfmt = self.endian + "qQ"
+            self.pfmt = self.endian + "IIQQQQQQ"
+        else:
+            self.hfmt = self.endian + "HHIIIIIHHHHHH"
+            self.sfmt = self.endian + "IIIIIIIIII"
+            self.dfmt = self.endian + "iI"
+            self.pfmt = self.endian + "IIIIIIII"
+        hdr = struct.unpack_from(self.hfmt, self.data, 16)
+        (self.e_phoff, self.e_shoff, self.e_phentsize,
+         self.e_phnum, self.e_shentsize, self.e_shnum) = \
+            hdr[4], hdr[5], hdr[8], hdr[9], hdr[10], hdr[11]
+        self.e_shstrndx = hdr[12]
+        self.secs = self._sections()
+
+    def _sections(self):
+        secs = []
+        for i in range(self.e_shnum):
+            e = struct.unpack_from(self.sfmt, self.data,
+                                   self.e_shoff + i * self.e_shentsize)
+            secs.append({"name": e[0], "type": e[1], "flags": e[2],
+                         "addr": e[3], "off": e[4], "size": e[5],
+                         "entsize": e[9]})
+        strsec = secs[self.e_shstrndx]
+        strs = self.data[strsec["off"]:strsec["off"] + strsec["size"]]
+        for s in secs:
+            n = strs.find(b"\0", s["name"])
+            s["name"] = strs[s["name"]:n].decode()
+        return secs
+
+    def section_by_name(self, name):
+        for s in self.secs:
+            if s["name"] == name:
+                return s
+        return None
+
+    def dyn_tags(self):
+        tags = {}
+        dynsec = None
+        for s in self.secs:
+            if s["type"] == SHT_DYNAMIC:
+                dynsec = s
+        if dynsec is None:
+            return tags
+        size = 16 if self.is64 else 8
+        for off in range(dynsec["off"], dynsec["off"] + dynsec["size"], size):
+            tag, val = struct.unpack_from(self.dfmt, self.data, off)
+            if tag == 0:
+                break
+            tags[tag] = val
+        return tags
+
+    def vaddr_to_off(self, addr):
+        for i in range(self.e_phnum):
+            p = struct.unpack_from(self.pfmt, self.data,
+                                   self.e_phoff + i * self.e_phentsize)
+            if self.is64:
+                p_type, p_offset, p_vaddr, p_filesz = p[0], p[2], p[3], p[5]
+            else:
+                p_type, p_offset, p_vaddr, p_filesz = p[0], p[1], p[2], p[4]
+            if p_type == PT_LOAD and p_vaddr <= addr < p_vaddr + p_filesz:
+                return p_offset + addr - p_vaddr
+        return None
+
+
+def read_sleb128(data, pos):
+    result = 0
+    shift = 0
+    while True:
+        b = data[pos]
+        pos += 1
+        result |= (b & 0x7F) << shift
+        shift += 7
+        if not (b & 0x80):
+            break
+    if shift < 64 and b & 0x40:
+        result -= 1 << shift
+    return result, pos
+
+
+def decode_aps2(blob):
+    """Decode an APS2 blob the way bionic's linker does."""
+    if blob[:4] != b"APS2":
+        return None
+    pos = 4
+    count, pos = read_sleb128(blob, pos)
+    offset, pos = read_sleb128(blob, pos)
+    addend = 0
+    relocs = []
+    while len(relocs) < count:
+        group_size, pos = read_sleb128(blob, pos)
+        flags, pos = read_sleb128(blob, pos)
+        if flags & RELOCATION_GROUPED_BY_OFFSET_DELTA_FLAG:
+            group_offset_delta, pos = read_sleb128(blob, pos)
+        else:
+            group_offset_delta = 0
+        if flags & RELOCATION_GROUPED_BY_INFO_FLAG:
+            group_r_info, pos = read_sleb128(blob, pos)
+        else:
+            group_r_info = 0
+        if ((flags & RELOCATION_GROUP_HAS_ADDEND_FLAG)
+                and (flags & RELOCATION_GROUPED_BY_ADDEND_FLAG)):
+            delta, pos = read_sleb128(blob, pos)
+            addend += delta
+        if not (flags & RELOCATION_GROUP_HAS_ADDEND_FLAG):
+            addend = 0
+        for _ in range(group_size):
+            if flags & RELOCATION_GROUPED_BY_OFFSET_DELTA_FLAG:
+                offset += group_offset_delta
+            else:
+                delta, pos = read_sleb128(blob, pos)
+                offset += delta
+            if flags & RELOCATION_GROUPED_BY_INFO_FLAG:
+                r_info = group_r_info
+            else:
+                r_info, pos = read_sleb128(blob, pos)
+            if ((flags & RELOCATION_GROUP_HAS_ADDEND_FLAG)
+                    and not (flags & RELOCATION_GROUPED_BY_ADDEND_FLAG)):
+                delta, pos = read_sleb128(blob, pos)
+                addend += delta
+            relocs.append((offset, r_info, addend))
+    if len(relocs) != count:
+        return None
+    return relocs
+
+
+def decode_relr(elf, tags):
+    """Return RELR entries as pseudo-relocations (offset, 0, addend),
+    where the addend is the value stored at the relocation site."""
+    addr = tags.get(DT_RELR)
+    if addr is None:
+        return []
+    sec = None
+    for s in elf.secs:
+        if s["type"] == SHT_RELR:
+            sec = s
+    if sec is None:
+        return []
+    wsize = 8 if elf.is64 else 4
+    wfmt = elf.endian + ("Q" if elf.is64 else "I")
+    relocs = []
+    current = 0
+    for i in range(sec["size"] // wsize):
+        w = struct.unpack_from(wfmt, elf.data, sec["off"] + i * wsize)[0]
+        if w % 2 == 0:
+            current = w
+            relocs.append(current)
+            current += wsize
+        else:
+            b = w >> 1
+            bit_off = current
+            while b:
+                if b & 1:
+                    relocs.append(bit_off)
+                b >>= 1
+                bit_off += wsize
+            current = bit_off
+    out = []
+    for r in relocs:
+        voff = elf.vaddr_to_off(r)
+        addend = struct.unpack_from(wfmt, elf.data, voff)[0]
+        out.append((r, 0, addend))
+    return out
+
+
+def plain_relocs(elf, sec, is_rela):
+    relocs = []
+    if is_rela:
+        fmt, size = (elf.endian + "QQq", 24) if elf.is64 \
+            else (elf.endian + "IIi", 12)
+    else:
+        fmt, size = (elf.endian + "QQ", 16) if elf.is64 \
+            else (elf.endian + "II", 8)
+    for off in range(sec["off"], sec["off"] + sec["size"], size):
+        r = struct.unpack_from(fmt, elf.data, off)
+        relocs.append((r[0], r[1], r[2] if is_rela else 0))
+    return relocs
+
+
+def normalize(relocs, elf, is_rela):
+    """Make relocations comparable across links whose layouts differ
+    slightly (the packed link has a smaller .dynamic section, which
+    moves following sections).  Addresses are rewritten as
+    (section name, offset within section).  RELATIVE relocation
+    addends are addresses and are normalized as well."""
+    alloc = [s for s in elf.secs if s["flags"] & 2 and s["size"] != 0]
+
+    def norm(addr):
+        best = None
+        for s in alloc:
+            if s["addr"] <= addr < s["addr"] + s["size"]:
+                d = addr - s["addr"]
+                if best is None or d < best[1]:
+                    best = (s["name"], d)
+        return best if best else ("", addr)
+
+    if elf.is64:
+        type_mask, sym_shift = 0xFFFFFFFF, 32
+    else:
+        type_mask, sym_shift = 0xFF, 8
+
+    out = []
+    for off, info, add in relocs:
+        r_sym = info >> sym_shift
+        if r_sym == 0:
+            # Relative (and NONE) relocations have a zero symbol index
+            # on all targets.  Canonicalize the type so that
+            # target-specific R_*_RELATIVE values (and relocations
+            # recovered from .relr.dyn) compare equal.
+            r_type = "RELATIVE"
+        else:
+            r_type = info & type_mask
+        out.append((norm(off), r_type, r_sym, norm(add) if is_rela else 0))
+    return sorted(out)
+
+
+def main():
+    failures = []
+
+    packed_path = sys.argv[1]
+    plain_path = sys.argv[2] if len(sys.argv) > 2 else None
+
+    elf = ELF(packed_path)
+    tags = elf.dyn_tags()
+
+    sec = elf.section_by_name(".rela.dyn")
+    is_rela = True
+    if sec is None:
+        sec = elf.section_by_name(".rel.dyn")
+        is_rela = False
+    if sec is None:
+        print("FAIL: no .rela.dyn/.rel.dyn section found")
+        sys.exit(1)
+
+    if sec["type"] != (SHT_ANDROID_RELA if is_rela else SHT_ANDROID_REL):
+        failures.append("section `%s' type is %#x, not SHT_ANDROID_REL%s"
+                        % (sec["name"], sec["type"], "A" if is_rela else ""))
+    if sec["entsize"] != 0:
+        failures.append("section `%s' has nonzero sh_entsize" % sec["name"])
+
+    dt_addr = tags.get(DT_ANDROID_RELA if is_rela else DT_ANDROID_REL)
+    dt_size = tags.get(DT_ANDROID_RELASZ if is_rela else DT_ANDROID_RELSZ)
+    if dt_addr is None:
+        failures.append("DT_ANDROID_REL%s not present" % ("A" if is_rela else ""))
+    elif dt_addr != sec["addr"]:
+        failures.append("DT_ANDROID_REL%s is %#x, section address is %#x"
+                        % (("A" if is_rela else ""), dt_addr, sec["addr"]))
+    if dt_size is None:
+        failures.append("DT_ANDROID_REL%sSZ not present"
+                        % ("A" if is_rela else ""))
+    elif dt_size != sec["size"]:
+        failures.append("DT_ANDROID_REL%sSZ is %#x, section size is %#x"
+                        % (("A" if is_rela else ""), dt_size, sec["size"]))
+    if (DT_RELA if is_rela else DT_REL) in tags:
+        failures.append("standard DT_REL%s tag emitted along with "
+                        "Android relocations" % ("A" if is_rela else ""))
+
+    blob = elf.data[sec["off"]:sec["off"] + sec["size"]]
+    relocs = decode_aps2(blob)
+    if relocs is None:
+        failures.append("invalid packed relocation data")
+        relocs = []
+    relocs += decode_relr(elf, tags)
+
+    if plain_path is not None:
+        pelf = ELF(plain_path)
+        psec = pelf.section_by_name(".rela.dyn" if is_rela else ".rel.dyn")
+        if psec is None:
+            failures.append("%s: no .rela.dyn/.rel.dyn section found"
+                            % plain_path)
+        else:
+            prelocs = plain_relocs(pelf, psec, is_rela)
+            ptags = pelf.dyn_tags()
+            prelocs += decode_relr(pelf, ptags)
+            got = normalize(relocs, elf, is_rela)
+            want = normalize(prelocs, pelf, is_rela)
+            if got != want:
+                for a, b in zip(got, want):
+                    if a != b:
+                        failures.append("packed reloc %s does not match "
+                                        "plain reloc %s" % (a, b))
+                        break
+                failures.append("packed relocation count %d does not match "
+                                "plain relocation count %d"
+                                % (len(relocs), len(prelocs)))
+
+    for f in failures:
+        print("FAIL:", f)
+    if failures:
+        sys.exit(1)
+    print("PASS: %d packed relocations verified" % len(relocs))
+
+
+if __name__ == "__main__":
+    main()
