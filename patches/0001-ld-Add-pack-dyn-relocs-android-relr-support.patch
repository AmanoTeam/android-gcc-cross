diff --git a/ld/testsuite/ld-elf/pack-dyn-relocs.exp b/ld/testsuite/ld-elf/pack-dyn-relocs.exp
new file mode 100644
index 00000000..67bac63d
--- /dev/null
+++ b/ld/testsuite/ld-elf/pack-dyn-relocs.exp
@@ -0,0 +1,104 @@
+# Expect script for --pack-dyn-relocs tests.
+#   Copyright (C) 2026 Free Software Foundation, Inc.
+#
+# This file is part of the GNU Binutils.
+#
+# This program is free software; you can redistribute it and/or modify
+# it under the terms of the GNU General Public License as published by
+# the Free Software Foundation; either version 3 of the License, or
+# (at your option) any later version.
+#
+# This program is distributed in the hope that it will be useful,
+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with this program; if not, write to the Free Software
+# Foundation, Inc., 51 Franklin Street - Fifth Floor, Boston,
+# MA 02110-1301, USA.
+#
+
+# Verify that --pack-dyn-relocs=android is accepted and that the
+# resulting Android packed relocation data decodes, using the same
+# algorithm as Android's dynamic linker, to exactly the relocations
+# produced by a normal link.
+
+if ![is_elf_format] {
+    return
+}
+
+if { ![check_shared_lib_support] } {
+    return
+}
+
+# The packed relocation decoder is written in Python.
+set status [remote_exec host python3 --version]
+if { [lindex $status 0] != 0 } {
+    unsupported "Python 3 is not available"
+    return
+}
+
+set testname "--pack-dyn-relocs=android"
+set checker $srcdir/$subdir/pack-dyn-relocs-check.py
+
+if { [check_compiler_available] } {
+    set srcfile $srcdir/$subdir/pack-dyn-relocs-1.c
+    if { ![ld_compile "$CC_FOR_TARGET -fPIC" $srcfile \
+	     tmpdir/pack-dyn-relocs-1.o] } {
+	unresolved "$testname"
+	return
+    }
+} else {
+    # Fall back to the assembler test source when there is no C
+    # compiler for the target.
+    set srcfile $srcdir/$subdir/pack-dyn-relocs.s
+    if { ![ld_assemble $as $srcfile tmpdir/pack-dyn-relocs-1.o] } {
+	unresolved "$testname"
+	return
+    }
+}
+
+if { ![ld_link $ld tmpdir/pack-dyn-relocs-1-plain.so \
+	 "-shared tmpdir/pack-dyn-relocs-1.o"] } {
+    fail "$testname: plain link failed"
+    return
+}
+
+if { ![ld_link $ld tmpdir/pack-dyn-relocs-1-android.so \
+	 "-shared --pack-dyn-relocs=android tmpdir/pack-dyn-relocs-1.o"] } {
+    fail "$testname: link failed"
+    return
+}
+pass "$testname: link"
+
+set status [remote_exec host python3 [list $checker \
+	 tmpdir/pack-dyn-relocs-1-android.so \
+	 tmpdir/pack-dyn-relocs-1-plain.so]]
+if { [lindex $status 0] != 0 } {
+    send_log "[lindex $status 1]\n"
+    fail "$testname: packed relocations do not match plain relocations"
+} else {
+    pass "$testname: packed relocations match plain relocations"
+}
+
+if { [supports_dt_relr] } {
+    set testname "--pack-dyn-relocs=android+relr"
+
+    if { ![ld_link $ld tmpdir/pack-dyn-relocs-1-android-relr.so \
+	     "-shared --pack-dyn-relocs=android+relr tmpdir/pack-dyn-relocs-1.o"] } {
+	fail "$testname: link failed"
+	return
+    }
+    pass "$testname: link"
+
+    set status [remote_exec host python3 [list $checker \
+	     tmpdir/pack-dyn-relocs-1-android-relr.so \
+	     tmpdir/pack-dyn-relocs-1-plain.so]]
+    if { [lindex $status 0] != 0 } {
+	send_log "[lindex $status 1]\n"
+	fail "$testname: packed relocations do not match plain relocations"
+    } else {
+	pass "$testname: packed relocations match plain relocations"
+    }
+}
diff --git a/ld/testsuite/ld-elf/pack-dyn-relocs.s b/ld/testsuite/ld-elf/pack-dyn-relocs.s
new file mode 100644
index 00000000..62cafe2a
--- /dev/null
+++ b/ld/testsuite/ld-elf/pack-dyn-relocs.s
@@ -0,0 +1,35 @@
+	.text
+	.p2align 3
+	.globl func_start
+func_start:
+	.byte 0
+
+	.data
+	.p2align 3
+	.globl data_var
+data_var:
+	.dc.a 1
+
+	.local hidden_var
+hidden_var:
+	.dc.a 2
+
+	/* RELATIVE relocs against a local symbol.  */
+	.globl ptr1
+ptr1:
+	.dc.a hidden_var
+	.globl ptr2
+ptr2:
+	.dc.a hidden_var
+
+	/* Relocs against a global symbol.  */
+	.globl ptr3
+ptr3:
+	.dc.a data_var
+	.globl ptr4
+ptr4:
+	.dc.a data_var
+
+	.globl func_ptr
+func_ptr:
+	.dc.a func_start
