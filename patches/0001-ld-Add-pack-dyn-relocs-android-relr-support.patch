+/* A dynamic relocation to be stored in the Android packed relocation
+   format.  */
+
+struct elf_android_reloc
+{
+  bfd_vma r_offset;
+  bfd_vma r_info;
+  bfd_vma r_sym;
+  bfd_vma r_type;
+  bfd_signed_vma r_addend;
+};
+
+/* Write VAL, SLEB128 encoded, to P, never writing more than END
+   bytes.  Returns the updated pointer, or NULL on overflow.  */
+
+static bfd_byte *
+elf_android_sleb128 (bfd_byte *p, bfd_byte *end, bfd_signed_vma val)
+{
+  bfd_byte byte;
+
+  do
+    {
+      byte = val & 0x7f;
+      val >>= 7;
+      if (p >= end)
+	return NULL;
+      if ((val == 0 && (byte & 0x40) == 0)
+	  || (val == (bfd_signed_vma) -1 && (byte & 0x40) != 0))
+	{
+	  *p++ = byte;
+	  break;
+	}
+      *p++ = byte | 0x80;
+    }
+  while (1);
+
+  return p;
+}
+
+/* Compare Android packed relocations by r_type, then r_sym, then
+   r_offset.  This sorts relocations of the same type (typically
+   R_*_RELATIVE, the vast majority) so that all of them end up in
+   consecutive runs with equal r_info and equal offset deltas, which
+   the Android packed relocation format can encode most compactly.  */
+
+static int
+elf_android_reloc_cmp (const void *ap, const void *bp)
+{
+  const struct elf_android_reloc *a = ap;
+  const struct elf_android_reloc *b = bp;
+
+  if (a->r_type != b->r_type)
+    return a->r_type < b->r_type ? -1 : 1;
+  if (a->r_sym != b->r_sym)
+    return a->r_sym < b->r_sym ? -1 : 1;
+  if (a->r_offset != b->r_offset)
+    return a->r_offset < b->r_offset ? -1 : 1;
+  if (a->r_addend != b->r_addend)
+    return a->r_addend < b->r_addend ? -1 : 1;
+  return 0;
+}
+
+/* Encode the COUNT dynamic relocations in RELS using the Android
+   packed relocation format, for either REL or RELA input as selected
+   by RELA_P.  The encoding consists of the magic bytes "APS2"
+   followed by SLEB128-encoded fields.  Relocations are emitted in
+   groups; within a group, common offset deltas and r_info values are
+   factored out so that each relocation in the group only needs its
+   addend recorded.  See bionic's linker/linker_relocs.cpp for the
+   reference decoder.
+
+   The output is written to BUF, which is END bytes long.  Returns the
+   number of bytes written, or 0 on overflow.  */
+
+static bfd_size_type
+elf_android_encode_relocs (bfd_byte *buf, bfd_byte *end,
+			   const struct elf_android_reloc *rels,
+			   bfd_size_type count, bool rela_p)
+{
+  bfd_byte *p;
+  bfd_signed_vma prev_offset, prev_addend;
+  bfd_size_type i;
+
+  if (end - buf < 4)
+    return 0;
+
+  p = buf;
+  memcpy (p, "APS2", 4);
+  p += 4;
+
+  /* The total number of relocations, and the initial r_offset (we
+     start at zero; the first group performs the initial
+     adjustment).  */
+  p = elf_android_sleb128 (p, end, (bfd_signed_vma) count);
+  p = elf_android_sleb128 (p, end, 0);
+  if (p == NULL)
+    return 0;
+
+  prev_offset = 0;
+  prev_addend = 0;
+  i = 0;
+  while (i < count)
+    {
+      bfd_signed_vma offset_delta, addend;
+      bfd_vma r_info;
+      bfd_size_type j, size;
+      bfd_signed_vma flags;
+
+      offset_delta = (bfd_signed_vma) (rels[i].r_offset - prev_offset);
+      r_info = rels[i].r_info;
+
+      /* Greedily extend the group while consecutive relocations
+	 share the same r_info and offset delta.  */
+      j = i + 1;
+      while (j < count
+	     && rels[j].r_info == r_info
+	     && rels[j].r_offset - rels[j - 1].r_offset
+		== (bfd_vma) offset_delta)
+	j++;
+
+      size = j - i;
+      flags = 0;
+      if (size > 1)
+	flags = (RELOCATION_GROUPED_BY_INFO_FLAG
+		 | RELOCATION_GROUPED_BY_OFFSET_DELTA_FLAG);
+      if (rela_p)
+	flags |= RELOCATION_GROUP_HAS_ADDEND_FLAG;
+
+      p = elf_android_sleb128 (p, end, (bfd_signed_vma) size);
+      p = elf_android_sleb128 (p, end, flags);
+      p = elf_android_sleb128 (p, end, offset_delta);
+      p = elf_android_sleb128 (p, end, (bfd_signed_vma) r_info);
+      if (p == NULL)
+	return 0;
+
+      if (rela_p)
+	for (; i < j; i++)
+	  {
+	    addend = rels[i].r_addend - prev_addend;
+	    p = elf_android_sleb128 (p, end, addend);
+	    if (p == NULL)
+	      return 0;
+	    prev_addend = rels[i].r_addend;
+	  }
+      else
+	i = j;
+
+      prev_offset = rels[j - 1].r_offset;
+    }
+
+  return p - buf;
+}
+
+/* Collect the dynamic relocations contained in the .rela.dyn or
+   .rel.dyn output section, encode them in the Android packed
+   relocation format, and arrange for the encoded data to be written
+   to the output section after all other sections created by
+   bfd_elf_link_create_dynamic_sections.  Returns false on error.  */
+
+static bool
+elf_link_android_pack_relocs (bfd *obfd, struct bfd_link_info *info)
+{
+  elf_backend_data *obed;
+  struct elf_link_hash_table *htab = elf_hash_table (info);
+  asection *outsec;
+  struct bfd_link_order *lo;
+  bfd *dynobj = htab->dynobj;
+  bfd_byte *contents;
+  struct elf_android_reloc *rels;
+  struct elf_android_reloc *rel;
+  bfd_size_type ext_size, count, i2e;
+  bfd_size_type used;
+  void (*swap_in) (bfd *, const bfd_byte *, Elf_Internal_Rela *);
+  bool use_rela;
+
+  outsec = htab->android_rela_sec;
+  if (outsec == NULL || outsec->size == 0)
+    /* Nothing to pack.  Any DT_ANDROID_* entries are removed below.  */
+    return true;
+
+  obed = get_elf_backend_data (obfd);
+  use_rela = (elf_section_data (outsec)->this_hdr.sh_type
+	      == SHT_ANDROID_RELA);
+
+  if (use_rela)
+    {
+      ext_size = obed->s->sizeof_rela;
+      swap_in = obed->s->swap_reloca_in;
+    }
+  else
+    {
+      ext_size = obed->s->sizeof_rel;
+      swap_in = obed->s->swap_reloc_in;
+    }
+  i2e = obed->s->int_rels_per_ext_rel;
+
+  /* Gather the relocations from all of the input sections.  The
+     section contents were finalized when the input sections were
+     relocated above.  */
+  count = 0;
+  for (lo = outsec->map_head.link_order; lo != NULL; lo = lo->next)
+    {
+      asection *o;
+
+      if (lo->type != bfd_indirect_link_order)
+	continue;
+
+      o = lo->u.indirect.section;
+      if (o->owner != dynobj
+	  || (o->flags & SEC_LINKER_CREATED) == 0
+	  || (o->contents == NULL && o->size != 0))
+	{
+	  /* Not a dynamic relocation section created by the linker,
+	     e.g. one created for --emit-relocs.  We can't combine
+	     relocations in this case.  */
+	  _bfd_error_handler
+	    /* xgettext:c-format */
+	    (_("%pB: unable to pack relocations from section `%pA'"),
+	     obfd, o);
+	  bfd_set_error (bfd_error_invalid_operation);
+	  return false;
+	}
+      if (o->size % ext_size)
+	{
+	  _bfd_error_handler
+	    /* xgettext:c-format */
+	    (_("%pB: unable to pack relocations from section `%pA' - "
+	       "its size is not a multiple of the relocation size"),
+	     obfd, o);
+	  bfd_set_error (bfd_error_invalid_operation);
+	  return false;
+	}
+      count += o->size / ext_size * i2e;
+    }
+
+  rels = bfd_malloc (count * sizeof (*rels));
+  if (rels == NULL)
+    return false;
+
+  rel = rels;
+  for (lo = outsec->map_head.link_order; lo != NULL; lo = lo->next)
+    {
+      asection *o;
+      bfd_byte *erel, *erelend;
+
+      if (lo->type != bfd_indirect_link_order)
+	continue;
+
+      o = lo->u.indirect.section;
+      erel = o->contents;
+      erelend = o->contents + o->size;
+      while (erel < erelend)
+	{
+	  Elf_Internal_Rela irel[MAX_INT_RELS_PER_EXT_REL];
+	  size_t i;
+
+	  (*swap_in) (obfd, erel, irel);
+	  erel += ext_size;
+
+	  for (i = 0; i < i2e; i++)
+	    {
+	      rel->r_offset = irel[i].r_offset;
+	      rel->r_info = irel[i].r_info;
+	      rel->r_addend = irel[i].r_addend;
+	      if (obed->s->arch_size == 32)
+		{
+		  rel->r_sym = irel[i].r_info >> 8;
+		  rel->r_type = irel[i].r_info & 0xff;
+		}
+	      else
+		{
+		  rel->r_sym = irel[i].r_info >> 32;
+		  rel->r_type = irel[i].r_info & 0xffffffff;
+		}
+	      rel++;
+	    }
+	}
+    }
+  /* We counted correctly.  */
+  BFD_ASSERT (rel == rels + count);
+
+  /* Sort the relocations so that the groups are as large as
+     possible.  */
+  qsort (rels, count, sizeof (*rels), elf_android_reloc_cmp);
+
+  contents = bfd_zmalloc (outsec->size);
+  if (contents == NULL)
+    {
+      free (rels);
+      return false;
+    }
+
+  used = elf_android_encode_relocs (contents, contents + outsec->size,
+				    rels, count, use_rela);
+  free (rels);
+  if (used == 0)
+    {
+      _bfd_error_handler
+	/* xgettext:c-format */
+	(_("%pB: unable to pack relocations - encoded size exceeds "
+	   "allocated section `%pA' size"), obfd, outsec);
+      bfd_set_error (bfd_error_invalid_operation);
+      free (contents);
+      return false;
+    }
+
+  /* Set the real size of the packed data; the rest of the section
+     stays zero-filled.  Shrink the section size so that
+     DT_ANDROID_RELASZ/RELSZ and tools see the real size.  Layout was
+     already computed when the section size was set, and the segment
+     covering this section keeps its size; the padding bytes are
+     never parsed.  */
+  elf_section_data (outsec)->this_hdr.sh_size = used;
+
+  htab->android_rela_sec = outsec;
+  htab->android_rela_contents = contents;
+
+  return true;
+}
+
 /* Do the final step of an ELF link.  */
 
 bool
@@ -12918,6 +13239,59 @@ _bfd_elf_final_link (bfd *obfd, struct bfd_link_info *info)
   if (! bfd_link_relocatable (info) && merged)
     elf_link_hash_traverse (htab, _bfd_elf_link_sec_merge_syms, obfd);
 
+  /* When packing dynamic relocations in the Android format, find the
+     output section holding them and change its type to
+     SHT_ANDROID_RELA/SHT_ANDROID_REL before the section headers are
+     set up.  This mirrors the way DT_RELA/DT_REL is computed below:
+     all allocatable SHT_REL/SHT_RELA sections except .rela.plt are
+     used; there must be at most one of them, which is the case with
+     the default linker scripts (-z combreloc merges everything into
+     .rela.dyn/.rel.dyn).  PLT relocations referenced by DT_JMPREL
+     keep the standard format since Android's dynamic linker, like
+     other dynamic linkers, decodes them as plain REL/RELA.  */
+  if (info->pack_dyn_relocs_android
+      && dynamic
+      && !bfd_link_relocatable (info))
+    {
+      asection *sec;
+      asection *android_reldyn = NULL;
+
+      for (sec = obfd->sections; sec != NULL; sec = sec->next)
+	{
+	  struct bfd_elf_section_data *esdo = elf_section_data (sec);
+	  unsigned int type = esdo->this_hdr.sh_type;
+
+	  if ((sec->flags & SEC_ALLOC) == 0
+	      || sec->size == 0
+	      || (type != SHT_REL && type != SHT_RELA)
+	      || (htab->srelplt != NULL
