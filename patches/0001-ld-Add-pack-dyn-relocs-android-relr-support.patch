diff --git a/ld/ld.texi b/ld/ld.texi
index 9d6618a4..e5302614 100644
--- a/ld/ld.texi
+++ b/ld/ld.texi
@@ -3342,6 +3342,25 @@ the classic ELF @code{.hash} and new style GNU @code{.gnu.hash}
 hash tables.  The default depends upon how the linker was configured,
 but for most Linux based systems it will be @code{both}.
 
+@kindex --pack-dyn-relocs=@var{style}
+@item --pack-dyn-relocs=@var{style}
+Set the format used to store dynamic relocations.  @var{style} can be
+@code{none}, @code{relr}, @code{android} or @code{android+relr}.
+
+The default, @code{none}, stores dynamic relocations in the standard
+ELF @code{.rel.dyn}/@code{.rela.dyn} format.  @code{relr} enables
+compact relative relocations in a @code{.relr.dyn} section, like
+@option{-z pack-relative-relocs}.  @code{android} stores the dynamic
+relocations in the Android packed relocation format in a
+@code{SHT_ANDROID_REL}/@code{SHT_ANDROID_RELA} section, and emits
+@code{DT_ANDROID_REL}/@code{DT_ANDROID_RELA} and
+@code{DT_ANDROID_RELSZ}/@code{DT_ANDROID_RELASZ} dynamic tags instead
+of the standard ones.  @code{android+relr} is the same but also
+diverts relative relocations to a @code{.relr.dyn} section on targets
+that support it.  The Android formats are understood by the dynamic
+linker on Android.  PLT relocations referenced by @code{DT_JMPREL}
+are not packed.
+
 @kindex --compress-debug-sections=none
 @kindex --compress-debug-sections=zlib
 @kindex --compress-debug-sections=zlib-gnu
