+#ifndef GCC_C_AVAILABILITY_H
+#define GCC_C_AVAILABILITY_H
+
+#include "machmode.h"
+#include "input.h"
+
+/* One specifier in a __builtin_available (or @available) expression.
+
+   For example, in the expression `__builtin_available (macos 10.10, *)',
+   both `macos 10.10' and `*' map to an availability_spec.  */
+
+struct availability_spec
+{
+  /* The version tuple parsed from the spec.  Major is required; minor
+     and subminor default to zero if omitted.  The field names are
+     prefixed with `ver_' so that they do not collide with the
+     `major ()' / `minor ()' macros exported by glibc's and DragonFly's
+     <sys/types.h> (and also <sys/sysmacros.h>).  */
+  unsigned HOST_WIDE_INT ver_major;
+  unsigned HOST_WIDE_INT ver_minor;
+  unsigned HOST_WIDE_INT ver_subminor;
+  /* True when this represents the '*' wildcard.  The fields above are
+     all zero in this case.  */
+  bool is_wildcard;
+  /* The canonical (lowercase) platform name accepted by the front end.
+     The string is permanently interned via get_identifier (), so it is
+     safe to keep as a plain pointer.  NULL for the wildcard.  */
+  const char *platform;
+  /* Source range of this spec, used for diagnostics.  */
+  location_t begin_loc;
+  location_t end_loc;
+
+  availability_spec ()
+    : ver_major (0), ver_minor (0), ver_subminor (0), is_wildcard (false),
+      platform (nullptr), begin_loc (UNKNOWN_LOCATION),
+      end_loc (UNKNOWN_LOCATION)
+  {}
+};
+
+/* Look up the canonical (lowercase) name for the platform spelt NAME.
+   Returns NULL if NAME is not a recognized __builtin_available platform
+   name (compared case-insensitively).  The returned string is owned by
+   c-availability.cc and lives for the entire program.  */
+extern const char *c_lookup_availability_platform (const char *name);
+
+/* Look up SPEC's platform among the spec list SPEC and return the
+   matching version, considering maccatalyst -> ios transcription and the
+   special anyAppleOS fallback for Darwin targets, mirroring Clang's
+   SemaObjC::ActOnObjCAvailabilityCheckExpr.  Returns true and writes the
+   chosen version into *OUT_* on success, false when no spec matches the
+   current target.  */
+
+extern bool
+c_lookup_target_availability_spec (vec<availability_spec> &specs,
+				  unsigned &out_major,
+				  unsigned &out_minor,
+				  unsigned &out_subminor);
+
+/* Validate the spec list SPEC and produce the semantic analysis shared
+   by both the C and C++ front ends.  Emits diagnostics:
+     - "must handle potential future platforms with '*'" if no wildcard
+     - "version for '%s' already specified" for duplicate platforms
+     - "'*' query has already been specified" for duplicate wildcards
+     - "unrecognized platform name '%s'" for unknown platform names
+   Returns nonzero on success, zero on failure.  */
+
+extern int c_validate_availability_specs (location_t loc,
+					  vec<availability_spec> &specs);
+
+/* Build the tree node for `__builtin_available (...)'.  SPECS is the
+   validated list of specs, LOC is the location of the `__builtin_available'
+   keyword, RPAREN_LOC the closing parenthesis.  Returns an integer tree
+   of type `bool' (where type matches what Clang emits: `_Bool').  Errors
+   are reported and integer_zero_node is returned.  */
+
+extern tree c_build_builtin_available (location_t loc,
+				       location_t rparen_loc,
+				       vec<availability_spec> &specs);
+
+#endif /* GCC_C_AVAILABILITY_H */
