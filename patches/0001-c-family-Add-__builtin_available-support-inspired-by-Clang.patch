@@ -0,0 +1,116 @@
+/* Support for the `__builtin_available' availability-check expression.
+   Shared between the C and C++ front ends (and usable by Objective-C
+   and Objective-C++).
+
+   The expression takes the form
+
+     __builtin_available ( platform-spec-list )
+
+   where platform-spec-list is a comma-separated list ending with the
+   mandatory wildcard `*'.  Each item (other than `*') is of the form
+   `platform-name version-tuple'.  The expression has type `bool' and
+   evaluates to a non-zero value at runtime when the runtime platform
+   matches one of the listed specs and is at least as new as the given
+   version; it evaluates to zero otherwise.
+
+   This mirrors Clang's `__builtin_available' / `@available' facility
+   (see clang/lib/Parse/ParseExpr.cpp:ParseAvailabilityCheckExpr).
+
