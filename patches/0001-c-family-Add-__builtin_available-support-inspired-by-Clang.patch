+/* Implementations of the TARGET_AVAILABILITY_* hooks for __builtin_available.
+
+   On Darwin we currently only know about macOS (the only platform whose
+   deployment target GCC is wired to handle via -mmacosx-version-min).  Mach-O
+   platform IDs come from ld64; values 0..6 are reserved here as the actual
+   platform IDs are needed only when emitting a Darwin runtime call to
+   __isPlatformVersionAtLeast and the IDs match the MachO::PlatformType used
+   by Clang's getBaseMachOPlatformID in CGObjC.cpp.  */
+
+#define DARWIN_PLATFORM_MACOS 1
+#define DARWIN_PLATFORM_IOS 2
+#define DARWIN_PLATFORM_TVOS 3
+#define DARWIN_PLATFORM_WATCHOS 4
+#define DARWIN_PLATFORM_XROS 5
+#define DARWIN_PLATFORM_DRIVERKIT 6
+
+const char *
+darwin_availability_platform_name (void)
+{
+  /* We currently know only macOS.  iOS-style targets aren't separately
+     handled by GCC's Darwin port.  */
+  return "macos";
+}
+
+bool
+darwin_availability_min_version (unsigned *major_p,
+				 unsigned *minor_p,
+				 unsigned *subminor_p)
+{
+  if (!darwin_macosx_version_min)
+    return false;
+  unsigned maj = 0, min = 0, tiny = 0;
+  int count = sscanf (darwin_macosx_version_min, "%u.%u.%u",
+		      &maj, &min, &tiny);
+  if (count <= 0)
+    return false;
+  if (count < 3)
+    tiny = 0;
+  if (count < 2)
+    min = 0;
+  *major_p = maj;
+  *minor_p = min;
+  *subminor_p = tiny;
+  return true;
+}
+
+int
+darwin_availability_platform_id (void)
+{
+  return DARWIN_PLATFORM_MACOS;
+}
