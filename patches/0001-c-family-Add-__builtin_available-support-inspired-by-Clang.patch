+#include "config.h"
+#include "system.h"
+#include "coretypes.h"
+#include "target.h"
+#include "c-availability.h"
+#include "c-common.h"
+#include "tree.h"
+#include "fold-const.h"
+#include "stringpool.h"
+#include "diagnostic.h"
+#include "gcc-rich-location.h"
+#include "intl.h"
+#include "langhooks.h"
+
+/* The set of canonical platform names understood by __builtin_available.
+   Names are matched case-insensitively during parsing and stored in the
+   canonical (lowercase) form, the same way Clang canonicalizes them in
+   AvailabilityAttr::canonicalizePlatformName.
+   The "*_application_extension" spellings are accepted as the matching
+   base platform, mirroring Clang.  */
+
+struct availability_platform_info_t
+{
+  const char *canonical;
+  const char *const *aliases;
+};
+
+static const char *const macos_aliases[] =
+  { "macos", "macosx", "osx", "darwin", nullptr };
+static const char *const ios_aliases[] =
+  { "ios", "iosapplicationextension", nullptr };
+static const char *const tvos_aliases[] =
+  { "tvos", "tvosapplicationextension", nullptr };
+static const char *const watchos_aliases[] =
+  { "watchos", "watchosapplicationextension", nullptr };
+static const char *const xros_aliases[] =
+  { "visionos", "xros", "visionosapplicationextension",
+    "xrosapplicationextension", nullptr };
+static const char *const maccatalyst_aliases[] =
+  { "maccatalyst", nullptr };
+static const char *const driverkit_aliases[] =
+  { "driverkit", nullptr };
+static const char *const anyappleos_aliases[] =
+  { "anyappleos", nullptr };
+/* Android NDK exposes __builtin_available(android N, *) for guarding newer
+   Android APIs.  See https://developer.android.com/ndk/guides/using-newer-apis
+   for the user-facing documentation; this matches Clang's "android" entry in
+   AvailabilityAttr::platform() and its triple-based PlatformName assignment
+   in clang/lib/Basic/Targets/OSTargets.h.  */
+static const char *const android_aliases[] =
+  { "android", nullptr };
+
+static const availability_platform_info_t platforms[] =
+{
+  { "macos", macos_aliases },
+  { "ios", ios_aliases },
+  { "tvos", tvos_aliases },
+  { "watchos", watchos_aliases },
+  { "visionos", xros_aliases },
+  { "maccatalyst", maccatalyst_aliases },
+  { "driverkit", driverkit_aliases },
+  { "anyappleos", anyappleos_aliases },
+  { "android", android_aliases },
+};
+
+/* Return the canonical (lowercase) name for the platform spelt NAME,
+   or NULL if NAME is not recognized.  Comparison is case-insensitive.  */
+
+const char *
+c_lookup_availability_platform (const char *name)
+{
+  if (name == nullptr)
+    return nullptr;
+  for (const auto &p : platforms)
+    for (const char *const *alias = p.aliases; *alias; ++alias)
+      if (strcasecmp (name, *alias) == 0)
+	return p.canonical;
+  return nullptr;
+}
+
+/* Helper: case-insensitive comparator for the platform map.  */
+
+static bool
+spec_platform_eq (const char *a, const char *b)
+{
+  if (!a || !b)
+    return false;
+  return strcasecmp (a, b) == 0;
+}
+
+/* Validate the spec list SPEC.  Emits diagnostics:
+     - "must handle potential future platforms with '*'" if no wildcard
+     - "'*' query has already been specified" for duplicate wildcards
+     - "version for '%s' already specified" for duplicate platforms
+   Returns nonzero on success, zero on failure.  LOC is used to pinpoint the
+   diagnostics when the underlying spec location is UNKNOWN_LOCATION.  */
+
+int
+c_validate_availability_specs (location_t loc,
+			      vec<availability_spec> &specs)
+{
+  bool seen_wildcard = false;
+  hash_set <const char *> /*nozero*/ platforms_seen;
+  bool dies = false;
+
+  for (const auto &spec : specs)
+    {
+      if (spec.is_wildcard)
+	{
+	  if (seen_wildcard)
+	    {
+	      error_at (spec.begin_loc,
+		 "%<*%> query has already been specified");
+	      dies = true;
+	    }
+	  seen_wildcard = true;
+	  continue;
+	}
+
+      /* Same canonical platform as a previously-seen spec?  */
+      if (spec.platform != nullptr)
+	{
+      bool dup = platforms_seen.add (spec.platform);
+	  if (dup)
+	    {
+	      gcc_rich_location richloc (spec.begin_loc);
+	      richloc.add_range (spec.end_loc);
+	      error_at (&richloc,
+			 "version for %qs already specified",
+			 spec.platform);
+	      dies = true;
+	    }
+	}
+      else
+	{
+	  error_at (loc, "expected a platform name here");
+	  dies = true;
+	}
+    }
+
+  if (!seen_wildcard && !dies)
+    {
+      if (!specs.is_empty ())
+	{
+	  location_t hint_point = specs.last ().end_loc;
+	  gcc_rich_location richloc (hint_point);
+	  richloc.add_fixit_insert_after (", *");
+	  error_at (&richloc,
+		     "must handle potential future platforms with %<*%>");
+	}
+      else
+	error_at (loc,
+		  "must handle potential future platforms with %<*%>");
+      return 0;
+    }
+
+  return dies ? 0 : 1;
+}
+
+/* Look up the spec matching the current target's runtime platform.
+   Returns true and writes the matched version into *MAJOR_P et al on
+   success.  Returns false when no spec matches the current target
+   platform, in which case the check is equivalent to the wildcard spec
+   `*' (i.e., always false at runtime, since this is a guard for a
+   future platform).
+
+   The mapping follows Clang's SemaObjC::ActOnObjCAvailabilityCheckExpr
+   (clang/lib/Sema/SemaExprObjC.cc):
+     - "maccatalyst" target reuses "ios" specs if "maccatalyst" is absent.
+     - Darwin targets fall back to "anyappleos" if neither the platform
+       nor "maccatalyst" matches a spec.  */
+
+bool
+c_lookup_target_availability_spec (vec<availability_spec> &specs,
+				   unsigned &out_major,
+				   unsigned &out_minor,
+				   unsigned &out_subminor)
+{
+  const char *platform = targetm.c.availability_platform_name ();
+  if (platform == nullptr)
+    return false;
+
+  auto find_spec = [&](const char *plat) -> const availability_spec * {
+    for (const auto &s : specs)
+      if (!s.is_wildcard && s.platform != nullptr && spec_platform_eq (s.platform, plat))
+	return &s;
+    return nullptr;
+  };
+
+  /* Try the platform name verbatim first.  */
+  const availability_spec *match = find_spec (platform);
+
+  bool is_darwin = targetm.c.availability_platform_id () != 0;
+
+  /* maccatalyst transcription.  */
+  if (match == nullptr && spec_platform_eq (platform, "maccatalyst"))
+    match = find_spec ("ios");
+
+  /* anyappleos fallback for Darwin targets.  */
+  if (match == nullptr && is_darwin)
+    match = find_spec ("anyappleos");
+
+  if (match == nullptr)
+    return false;
+
+  out_major = match->ver_major;
+  out_minor = match->ver_minor;
+  out_subminor = match->ver_subminor;
+  return true;
+}
+
+/* Lazily build and cache the runtime function decl that backs
+   __builtin_available.  On Darwin targets this is
+   __isPlatformVersionAtLeast (int platform, int major, int minor,
+			      int subminor) -> int;
+   on every other target (including non-macOS Apple-aware targets) it
+   is __isOSVersionAtLeast (int major, int minor, int subminor) -> int.
+   The decl is shared via a tree-by-frontend private static; we don't
+   GTY it as it will be kept alive by any single user and CC1 will release
+   all decls at teardown anyway.  */
+
+static GTY(()) tree platform_version_at_least_fn;
+static GTY(()) tree os_version_at_least_fn;
+
+static tree
+get_availability_runtime_fn (bool is_darwin)
+{
+  tree &slot = is_darwin ? platform_version_at_least_fn
+			: os_version_at_least_fn;
+  if (slot)
+    return slot;
+
+  tree *arg_types;
+  int nargs;
+  const char *name;
+
+  if (is_darwin)
+    {
+      nargs = 4;
+      arg_types = XALLOCAVEC (tree, nargs);
+      arg_types[0] = arg_types[1] = arg_types[2] = arg_types[3] = integer_type_node;
+      name = "__isPlatformVersionAtLeast";
+    }
+  else
+    {
+      nargs = 3;
+      arg_types = XALLOCAVEC (tree, nargs);
+      arg_types[0] = arg_types[1] = arg_types[2] = integer_type_node;
+      name = "__isOSVersionAtLeast";
+    }
+
+  tree fntype = build_function_type_array (integer_type_node, nargs, arg_types);
+  /* Use the language hook to allocate the FUNCTION_DECL itself so that
+     language-specific machinery (CJK's lang_decl for the C++ immediate
+     escalation walk, etc.) is set up correctly without interfering with
+     the call/lower-level name mangling.  The hook always yields a decl
+     with C-linkage semantics -- _Z<mangled> mangling does NOT apply --
+     matching the way the Android NDK (libandroid_support) provides
+     __isOSVersionAtLeast and Darwin's runtime provides
+     __isPlatformVersionAtLeast.  */
+  tree fndecl = lang_hooks.make_runtime_function_decl (name, fntype);
+  DECL_EXTERNAL (fndecl) = 1;
+  TREE_PUBLIC (fndecl) = 1;
+  DECL_ARTIFICIAL (fndecl) = 1;
+  TREE_NOTHROW (fndecl) = 1;
+  DECL_VISIBILITY (fndecl) = VISIBILITY_DEFAULT;
+  DECL_VISIBILITY_SPECIFIED (fndecl) = 1;
+  TREE_USED (fndecl) = 1;
+  slot = fndecl;
+  return fndecl;
+}
+
+/* Build the tree node for a validated __builtin_available (specs).
+   Returns a tree of type `bool'.  Caps: emits no diagnostics beyond
+   those already issued by c_validate_availability_specs.  On error,
+   returns integer_zero_node.  */
+
+tree
+c_build_builtin_available (location_t loc,
+			  location_t rparen_loc,
+			  vec<availability_spec> &specs)
+{
+  /* Match the spec for the current target.  */
+  unsigned mmajor = 0, mminor = 0, msubminor = 0;
+  bool matched = c_lookup_target_availability_spec (specs,
+						    mmajor, mminor, msubminor);
+
+  /* No platform-specific spec matched the target's runtime platform.
+     Following Clang's semantics in ActOnObjCAvailabilityCheckExpr /
+     ObjCAvailabilityCheckExpr::Evaluate, this case represents a wildcard-only
+     match (i.e. the '*' catch-all), which Clang folds to `true' regardless of
+     whether the target knows about any runtime platform at all.  For example,
+     __builtin_available(anyAppleOS 28, *) on Android/Linux triples folds to
+     true in Clang because Android's platform name 'android' is not an Apple
+     OS, so only the wildcard applies; see clang/test/CodeGen/
+     availability-check-anyappleos.c (CHECK-ANDROID: br i1 true).  */
+  if (!matched)
+    return convert (boolean_type_node, integer_one_node);
+
+  /* Fold-to-true when the asked-for version is no greater than the
+     compile-time known minimum deployment version.  */
+  unsigned dmin_major = 0, dmin_minor = 0, dmin_subminor = 0;
+  bool min_known =
+    targetm.c.availability_min_version (&dmin_major, &dmin_minor, &dmin_subminor);
+  if (min_known)
+    {
+      unsigned long have = ((unsigned long) dmin_major << 24)
+			 + ((unsigned long) dmin_minor << 12)
+			 + (unsigned long) dmin_subminor;
+      unsigned long want = ((unsigned long) mmajor << 24)
+			 + ((unsigned long) mminor << 12)
+			 + (unsigned long) msubminor;
+      if (want <= have)
+	return convert (boolean_type_node, integer_one_node);
+    }
+
+  /* Otherwise build a runtime call.  */
+  int platform_id = targetm.c.availability_platform_id ();
+  tree runtime_fn = get_availability_runtime_fn (platform_id != 0);
+
+  tree args[4];
+  int nargs = 0;
+  if (platform_id != 0)
+    args[nargs++] = build_int_cst (integer_type_node, platform_id);
+  args[nargs++] = build_int_cst (integer_type_node, mmajor);
+  args[nargs++] = build_int_cst (integer_type_node, mminor);
+  args[nargs++] = build_int_cst (integer_type_node, msubminor);
+
+  tree call = build_call_expr_loc_array (loc, runtime_fn, nargs, args);
+  /* Encode "result != 0" as a boolean.  */
+  tree cmp = build2_loc (loc, NE_EXPR, boolean_type_node, call,
+			 build_int_cst (integer_type_node, 0));
+  /* set_c_expr_source_range expects plain integer; the caller in the C
+     front-end handles further folding and source range bookkeeping.  */
+  if (EXPR_HAS_LOCATION (cmp))
+    protected_set_expr_location (cmp, loc);
+  tree ret = cmp;
+  if (rparen_loc != UNKNOWN_LOCATION)
+    protected_set_expr_location (ret, loc != UNKNOWN_LOCATION ? loc
+							 : rparen_loc);
+  return ret;
+}
+
+#include "gt-c-family-c-availability.h"
