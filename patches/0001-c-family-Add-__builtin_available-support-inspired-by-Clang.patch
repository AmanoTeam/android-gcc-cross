+/* Parse a __builtin_available availability-check expression.
+
+   Pre-condition: the BOOT token has already been consumed by the caller,
+   so the lexer is positioned at the '(' of the call.  The two-argument
+   form mirrors c_parser_builtin_available in the C front end.  */
+
+static cp_expr
+cp_parser_builtin_available (cp_parser *parser, location_t start_loc)
+{
+  matching_parens parens;
+  if (!parens.require_open (parser))
+    return error_mark_node;
+
+  auto_vec<availability_spec, 4> specs;
+
+  /* Empty list is rejected by the validator.  */
+  bool want_more = true;
+  if (cp_lexer_next_token_is (parser->lexer, CPP_CLOSE_PAREN))
+    want_more = false;
+
+  while (want_more)
+    {
+      availability_spec s;
+
+      /* The '*' wildcard.  */
+      if (cp_lexer_next_token_is (parser->lexer, CPP_MULT))
+	{
+	  cp_token *tok = cp_lexer_peek_token (parser->lexer);
+	  s.is_wildcard = true;
+	  s.begin_loc = tok->location;
+	  s.end_loc = tok->location;
+	  cp_lexer_consume_token (parser->lexer);
+	}
+      else
+	{
+	  /* platform-name version-tuple.  */
+	  if (cp_lexer_next_token_is_not (parser->lexer, CPP_NAME))
+	    {
+	      cp_parser_error (parser, "expected a platform name");
+	      cp_parser_skip_to_closing_parenthesis (parser, false, false, true);
+	      return error_mark_node;
+	    }
+	  cp_token *name_tok = cp_lexer_peek_token (parser->lexer);
+	  const char *name = IDENTIFIER_POINTER (name_tok->u.value);
+	  s.begin_loc = name_tok->location;
+	  s.platform = c_lookup_availability_platform (name);
+	  cp_lexer_consume_token (parser->lexer);
+
+	  if (s.platform == nullptr)
+	    {
+	      error_at (name_tok->location,
+			"unrecognized platform name %qs", name);
+	      cp_parser_skip_to_closing_parenthesis (parser, false, false, true);
+	      return error_mark_node;
+	    }
+
+	  /* Now expect a version-tuple: N(.N)?(.N)? or N(_N)?(_N)?.  */
+	  if (cp_lexer_next_token_is_not (parser->lexer, CPP_NUMBER))
+	    {
+	      cp_parser_error (parser, "expected a version");
+	      cp_parser_skip_to_closing_parenthesis (parser, false, false, true);
+	      return error_mark_node;
+	    }
+	  cp_token *ver_tok = cp_lexer_peek_token (parser->lexer);
+	  s.end_loc = ver_tok->location;
+
+	  /* Extract the source text of the version literal.  Same approach
+	     as in the C front-end version of this routine.  */
+	  source_range ver_range = get_range_from_loc (line_table,
+						  ver_tok->location);
+	  char *ver_text = nullptr;
+	  if (ver_range.m_start != UNKNOWN_LOCATION
+	      && ver_range.m_finish != UNKNOWN_LOCATION)
+	    {
+	      expanded_location start = expand_location (ver_range.m_start);
+	      expanded_location finish = expand_location (ver_range.m_finish);
+	      diagnostics::char_span line_span
+		= global_dc->get_file_cache ().get_source_line
+		    (start.file, start.line);
+	      if (line_span
+		  && start.line == finish.line
+		  && start.column >= 1
+		  && (size_t) start.column <= line_span.length ()
+		  && (size_t) finish.column <= line_span.length ()
+		  && start.column <= finish.column)
+		{
+		  diagnostics::char_span sub
+		    = line_span.subspan (start.column - 1,
+					 finish.column - start.column + 1);
+		  if (sub)
+		    ver_text = sub.xstrdup ();
+		}
+	    }
+
+	  if (!ver_text)
+	    {
+	      s.ver_major = 0;
+	      s.ver_minor = 0;
+	      s.ver_subminor = 0;
+	    }
+	  else
+	    {
+	      unsigned maj = 0, min = 0, sub = 0, *cur = &maj;
+	      bool any = false;
+	      for (const char *p = ver_text; *p; ++p)
+		{
+		  if (*p == '.' || *p == '_')
+		    {
+		      if (cur == &maj)
+			cur = &min;
+		      else if (cur == &min)
+			cur = &sub;
+		      else
+			{
+			  error_at (ver_tok->location,
+				     "invalid version %qs in "
+				     "availability check", ver_text);
+			  free (ver_text);
+			  cp_parser_skip_to_closing_parenthesis (parser, false, false, true);
+			  return error_mark_node;
+			}
+		      continue;
+		    }
+		  if (*p < '0' || *p > '9')
+		    {
+		      error_at (ver_tok->location,
+				 "invalid version %qs in "
+				 "availability check", ver_text);
+		      free (ver_text);
+		      cp_parser_skip_to_closing_parenthesis (parser, false, false, true);
+		      return error_mark_node;
+		    }
+		  *cur = *cur * 10u + (unsigned) (*p - '0');
+		  any = true;
+		}
+	      if (!any)
+		{
+		  error_at (ver_tok->location, "expected a version");
+		  free (ver_text);
+		  cp_parser_skip_to_closing_parenthesis (parser, false, false, true);
+		  return error_mark_node;
+		}
+	      s.ver_major = maj;
+	      s.ver_minor = min;
+	      s.ver_subminor = sub;
+	      free (ver_text);
+	    }
+
+	  cp_lexer_consume_token (parser->lexer);
+	}
+
+      specs.safe_push (s);
+
+      if (cp_lexer_next_token_is (parser->lexer, CPP_COMMA))
+	{
+	  cp_lexer_consume_token (parser->lexer);
+	  continue;
+	}
+      want_more = false;
+    }
+
+  if (!c_validate_availability_specs (start_loc, specs))
+    {
+      cp_parser_skip_to_closing_parenthesis (parser, false, false, true);
+      return error_mark_node;
+    }
+
+  location_t close_loc = cp_lexer_peek_token (parser->lexer)->location;
+  if (!parens.require_close (parser))
+    return error_mark_node;
+
+  tree value = c_build_builtin_available (start_loc, close_loc, specs);
+  return cp_expr (value, start_loc);
+}
+
