diff --git a/gcc/testsuite/g++.dg/builtin-available-1.C b/gcc/testsuite/g++.dg/builtin-available-1.C
new file mode 100644
index 00000000000..b48b38a0604
--- /dev/null
+++ b/gcc/testsuite/g++.dg/builtin-available-1.C
@@ -0,0 +1,41 @@
+/* Test that __builtin_available also works in C++.  */
+
+/* { dg-do compile } */
+/* { dg-options "" } */
+
+int
+main ()
+{
+  if (__builtin_available (macos 10.10, *))
+    return 1;
+  if (__builtin_available (macos 14.0, ios 17.0, *))
+    return 2;
+  if (__builtin_available (*))
+    return 3;
+
+  return 0;
+}
+
+int
+test_dup ()
+{
+  return __builtin_available (macos 10.10, macos 11.0, *); /* { dg-error "version for 'macos' already specified" } */
+}
+
+int
+test_no_wild ()
+{
+  return __builtin_available (macos 10.10); /* { dg-error "must handle potential future platforms" } */
+}
+
+int
+test_unknown ()
+{
+  return __builtin_available (nosuchos 1.0, *); /* { dg-error "unrecognized platform name" } */
+}
+
+int
+test_dup_wild ()
+{
+  return __builtin_available (*, *); /* { dg-error "already been specified" } */
+}
diff --git a/gcc/testsuite/g++.dg/builtin-available-android-1.C b/gcc/testsuite/g++.dg/builtin-available-android-1.C
new file mode 100644
index 00000000000..2be6985fc02
--- /dev/null
+++ b/gcc/testsuite/g++.dg/builtin-available-android-1.C
@@ -0,0 +1,47 @@
+/* Test __builtin_available (android N, *) codegen in C++ on Android
+   Linux.  Mirrors builtin-available-android-1.c but exercises the C++
+   front-end so we confirm that the runtime library function is emitted
+   with C linkage -- the symbol must NOT be name-mangled.
+
+   Before the lang_hook make_runtime_function_decl wired C++ through
+   build_library_fn_ptr, the C++ front-end produced
+   _Z20__isOSVersionAtLeastiii; Clang- and NDK-compatible codegen
+   requires the plain __isOSVersionAtLeast symbol.  */
+
+/* { dg-do compile } */
+/* { dg-options "-mandroid -mandroid-version-min=21 -O2" } */
+/* { dg-final { scan-assembler-times "__isOSVersionAtLeast" 2 } } */
+/* { dg-final { scan-assembler-not "_Z20__isOSVersionAtLeastiii" } } */
+/* { dg-final { scan-assembler-not "__isPlatformVersionAtLeast" } } */
+
+int
+f_newer (void)
+{
+  if (__builtin_available (android 31, *))
+    return 1;
+  return 0;
+}
+
+int
+f_mixed (void)
+{
+  if (__builtin_available (android 31, ios 13, macos 10.15, *))
+    return 1;
+  return 0;
+}
+
+int
+f_at_deployment (void)
+{
+  if (__builtin_available (android 21, *))
+    return 1;
+  return 0;
+}
+
+int
+f_below_deployment (void)
+{
+  if (__builtin_available (android 5, *))
+    return 1;
+  return 0;
+}
diff --git a/gcc/testsuite/gcc.dg/builtin-available-1.c b/gcc/testsuite/gcc.dg/builtin-available-1.c
new file mode 100644
index 00000000000..0566598009f
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/builtin-available-1.c
@@ -0,0 +1,85 @@
+/* Test that __builtin_available parses, accepts valid syntax,
+   folds to false on a non-Apple target, and emits correct diagnostics
+   for malformed invocations.  */
+
+/* { dg-do compile } */
+/* { dg-options "" } */
+
+int
+main (void)
+{
+  /* Legal syntax: parses, folds to 0 (false) on a non-Apple target.  */
+  if (__builtin_available (macos 10.10, *))
+    return 1;
+  if (__builtin_available (macos 14.0, ios 17.0, *))
+    return 2;
+  /* The wildcard * alone is allowed and matches any platform; on a
+     non-Apple target with no runtime hookups, no platform actually
+     matches and the validator only requires that the wildcard be
+     present, which it is here.  */
+  if (__builtin_available (*))
+    return 3;
+
+  return 0;
+}
+
+/* Duplicate platform must be diagnosed.  */
+int
+test_dup (void)
+{
+  return __builtin_available (macos 10.10, macos 11.0, *); /* { dg-error "version for 'macos' already specified" } */
+}
+
+/* Missing wildcard must be diagnosed.  */
+int
+test_no_wild (void)
+{
+  return __builtin_available (macos 10.10); /* { dg-error "must handle potential future platforms" } */
+}
+
+/* Unknown platform must be diagnosed.  */
+int
+test_unknown (void)
+{
+  return __builtin_available (nosuchos 1.0, *); /* { dg-error "unrecognized platform name 'nosuchos'" } */
+}
+
+/* Duplicate wildcard must be diagnosed.  */
+int
+test_dup_wild (void)
+{
+  return __builtin_available (*, *); /* { dg-error "query has already been specified" } */
+}
+
+/* Platform name lookup is case-insensitive: macOS/iOS/MacOS/ios all
+   canonicalize to the same canonical (lowercase) name.  Aliases like
+   "macosx", "osx" and "darwin" canonicalize to "macos".  */
+int
+test_case_insensitive (void)
+{
+  if (__builtin_available (macOS 10.15, iOS 13, *)) return 1;
+  if (__builtin_available (MACOSX 10.10, *)) return 2;
+  if (__builtin_available (watchOS 6, *)) return 3;
+  if (__builtin_available (TvOS 14, *)) return 4;
+  return 0;
+}
+
+int
+test_alias_dup (void)
+{
+  /* "macosx" and "macOS" both canonicalize to "macos" -- this should be
+     diagnosed as a duplicate use of the same platform.  */
+  return __builtin_available (macosx 10.10, macOS 11.0, *); /* { dg-error "version for 'macos' already specified" } */
+}
+
+/* Android NDK exposes __builtin_available (android N, *) for guarding
+   calls to APIs newer than the app's minSdkVersion.  See
+   https://developer.android.com/ndk/guides/using-newer-apis.  */
+int
+test_android (void)
+{
+  if (__builtin_available (android 31, *)) return 1;
+  if (__builtin_available (android 30, ios 13, macos 10.15, *)) return 2;
+  /* Duplicate android is diagnosed the same way as any other platform.  */
+  return __builtin_available (android 31, android 32, *); /* { dg-error "version for 'android' already specified" } */
+}
diff --git a/gcc/testsuite/gcc.dg/builtin-available-android-1.c b/gcc/testsuite/gcc.dg/builtin-available-android-1.c
new file mode 100644
index 00000000000..b9acf602ce7
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/builtin-available-android-1.c
@@ -0,0 +1,48 @@
+/* Test __builtin_available (android N, *) codegen on Android Linux with
+   -mandroid -mandroid-version-min=21 set.  We verify:
+
+     - android N > 21 (the deployment floor): a runtime call to
+       __isOSVersionAtLeast(N, 0, 0) is emitted.
+     - android N <= 21: folds to a constant (no runtime call).
+     - android N mixed with non-matching platforms: realises only the
+       android spec; macos/ios do not emit a runtime call to the
+       Darwin-specific __isPlatformVersionAtLeast helper.
+   All Clang-compatible: see clang/test/CodeGen/availability-check-anyappleos.c.
+*/
+
+/* { dg-do compile } */
+/* { dg-options "-mandroid -mandroid-version-min=21 -O2" } */
+/* { dg-final { scan-assembler-times "__isOSVersionAtLeast" 2 } } */
+/* { dg-final { scan-assembler-not "__isPlatformVersionAtLeast" } } */
+
+int
+f_newer (void)
+{
+  if (__builtin_available (android 31, *))
+    return 1;
+  return 0;
+}
+
+int
+f_mixed (void)
+{
+  if (__builtin_available (android 31, ios 13, macos 10.15, *))
+    return 1;
+  return 0;
+}
+
+int
+f_at_deployment (void)
+{
+  if (__builtin_available (android 21, *))
+    return 1;
+  return 0;
+}
+
+int
+f_below_deployment (void)
+{
+  if (__builtin_available (android 5, *))
+    return 1;
+  return 0;
+}
