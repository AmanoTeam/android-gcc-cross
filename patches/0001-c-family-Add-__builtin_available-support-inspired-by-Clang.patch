+
+   Android uses the non-Darwin variant of the availability runtime, so
+   availability_platform_id () returns 0 (matching the default hook); see
+   c_build_builtin_available in gcc/c-family/c-availability.cc.  The
+   runtime hook is provided by libandroid_support in the NDK, which wraps
+   android_get_device_api_level().  See
+   https://developer.android.com/ndk/guides/using-newer-apis for the
+   user-facing contract.
+
+   The hooks are also compiled into non-Android Linux targets (where
+   TARGET_ANDROID is 0 and android_version_min is 0), in which case they
+   fall through to the default behaviour (nullptr platform name, no known
+   min version), matching the non-Apple, non-Android baseline.  */
+
+const char *
+android_availability_platform_name (void)
+{
+  if (!TARGET_ANDROID)
+    return nullptr;
+  return "android";
+}
+
+bool
+android_availability_min_version (unsigned *major_p,
+				   unsigned *minor_p,
+				   unsigned *subminor_p)
+{
+  if (!TARGET_ANDROID || android_version_min == 0)
+    return false;
+
+  *major_p = (unsigned) android_version_min;
+  *minor_p = 0;
+  *subminor_p = 0;
+  return true;
+}
+
+int
+android_availability_platform_id (void)
+{
+  /* Android uses __isOSVersionAtLeast rather than the Darwin-specific
+     __isPlatformVersionAtLeast (platform_id, ...).  Returning 0 selects
+     the non-Darwin runtime in c_build_builtin_available.  */
+  return 0;
+}
