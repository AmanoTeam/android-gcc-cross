+/* Helper function for c_parser_postfix_expression.  Parse a
+   __builtin_available availability-check expression.
+
+   Pre-condition: the BOOT token has already been consumed by the caller,
+   so the parser is positioned at the '(' of the call.  */
+
+static struct c_expr
+c_parser_builtin_available (c_parser *parser, location_t start_loc)
+{
+  struct c_expr expr;
+  expr.original_code = ERROR_MARK;
+  expr.original_type = NULL;
+  expr.m_decimal = 0;
+
+  matching_parens parens;
+  if (!parens.require_open (parser))
+    {
+      expr.value = error_mark_node;
+      return expr;
+    }
+
+  /* The list of specs is comma-separated, ending with the mandatory
+     wildcard '*'.  */
+  auto_vec<availability_spec, 4> specs;
+
+  /* Empty __builtin_available () is rejected: at minimum the wildcard
+     is required, and our validator will emit the proper diagnostic.  */
+  bool want_more = true;
+  if (c_parser_next_token_is (parser, CPP_CLOSE_PAREN))
+    want_more = false;
+
+  while (want_more)
+    {
+      availability_spec s;
+
+      /* The '*' wildcard.  */
+      if (c_parser_next_token_is (parser, CPP_MULT))
+	{
+	  s.is_wildcard = true;
+	  s.begin_loc = c_parser_peek_token (parser)->location;
+	  s.end_loc = c_parser_peek_token (parser)->get_finish ();
+	  c_parser_consume_token (parser);
+	}
+      else
+	{
+	  /* platform-name version-tuple.  */
+	  if (c_parser_next_token_is_not (parser, CPP_NAME))
+	    {
+	      c_parser_error (parser, "expected a platform name");
+	      c_parser_skip_until_found (parser, CPP_CLOSE_PAREN, NULL);
+	      expr.value = error_mark_node;
+	      return expr;
+	    }
+	  location_t name_loc = c_parser_peek_token (parser)->location;
+	  tree name_tok = c_parser_peek_token (parser)->value;
+	  const char *name = IDENTIFIER_POINTER (name_tok);
+	  s.begin_loc = name_loc;
+	  s.platform = c_lookup_availability_platform (name);
+	  c_parser_consume_token (parser);
+
+	  if (s.platform == nullptr)
+	    {
+	      error_at (name_loc,
+			"unrecognized platform name %qs", name);
+	      c_parser_skip_until_found (parser, CPP_CLOSE_PAREN, NULL);
+	      expr.value = error_mark_node;
+	      return expr;
+	    }
+
+	  /* Now expect a version-tuple: a single numerical token of the form
+	     N(.N)?(.N)? or N(_N)?(_N)? (underscores are accepted like dots
+	     here, matching Clang's @available behavior).  */
+	  if (c_parser_next_token_is_not (parser, CPP_NUMBER))
+	    {
+	      c_parser_error (parser, "expected a version");
+	      c_parser_skip_until_found (parser, CPP_CLOSE_PAREN, NULL);
+	      expr.value = error_mark_node;
+	      return expr;
+	    }
+	  c_token *ver_tok = c_parser_peek_token (parser);
+	  s.end_loc = ver_tok->get_finish ();
+
+	  /* Re-derive the textual representation of the version by extracting
+	     the source text spanning the token's source range.  This avoids
+	     memory issues with using the possibly-rounded REAL_CST.  */
+	  source_range ver_range = ver_tok->get_range ();
+	  char *ver_text = nullptr;
+	  if (ver_range.m_start != UNKNOWN_LOCATION
+	      && ver_range.m_finish != UNKNOWN_LOCATION)
+	    {
+	      expanded_location start
+		= expand_location (ver_range.m_start);
+	      expanded_location finish
+		= expand_location (ver_range.m_finish);
+	      diagnostics::char_span line_span
+		= global_dc->get_file_cache ().get_source_line
+		    (start.file, start.line);
+	      if (line_span
+		  && start.line == finish.line
+		  && start.column >= 1
+		  && (size_t) start.column <= line_span.length ()
+		  && (size_t) finish.column <= line_span.length ()
+		  && start.column <= finish.column)
+		{
+		  diagnostics::char_span sub
+		    = line_span.subspan (start.column - 1,
+					 finish.column - start.column + 1);
+		  if (sub)
+		    ver_text = sub.xstrdup ();
+		}
+	    }
+
+	  if (ver_text == nullptr)
+	    {
+	      /* Fall back to a "0" version (treat as major=0).  This is
+		 mostly defensive.  */
+	      s.ver_major = 0;
+	      s.ver_minor = 0;
+	      s.ver_subminor = 0;
+	    }
+	  else
+	    {
+	      unsigned maj = 0, min = 0, sub = 0, *cur = &maj;
+	      bool any = false;
+	      for (const char *p = ver_text; *p; ++p)
+		{
+		  if (*p == '.' || *p == '_')
+		    {
+		      if (cur == &maj)
+			cur = &min;
+		      else if (cur == &min)
+			cur = &sub;
+		      else
+			{
+			  error_at (ver_tok->location,
+				     "invalid version %qs in "
+				     "availability check",
+				     ver_text);
+			  free (ver_text);
+			  c_parser_skip_until_found (parser,
+						     CPP_CLOSE_PAREN, NULL);
+			  expr.value = error_mark_node;
+			  return expr;
+			}
+		      continue;
+		    }
+		  if (*p < '0' || *p > '9')
+		    {
+		      error_at (ver_tok->location,
+				 "invalid version %qs in "
+				 "availability check",
+				 ver_text);
+		      free (ver_text);
+		      c_parser_skip_until_found (parser,
+						 CPP_CLOSE_PAREN, NULL);
+		      expr.value = error_mark_node;
+		      return expr;
+		    }
+		  *cur = *cur * 10u + (unsigned) (*p - '0');
+		  any = true;
+		}
+	      if (!any)
+		{
+		  error_at (ver_tok->location, "expected a version");
+		  free (ver_text);
+		  c_parser_skip_until_found (parser, CPP_CLOSE_PAREN, NULL);
+		  expr.value = error_mark_node;
+		  return expr;
+		}
+	      s.ver_major = maj;
+	      s.ver_minor = min;
+	      s.ver_subminor = sub;
+	      free (ver_text);
+	    }
+	  c_parser_consume_token (parser);
+	}
+
+      specs.safe_push (s);
+
+      if (c_parser_next_token_is (parser, CPP_COMMA))
+	{
+	  c_parser_consume_token (parser);
+	  continue;
+	}
+      want_more = false;
+    }
+
+  if (!c_validate_availability_specs (start_loc, specs))
+    {
+      c_parser_skip_until_found (parser, CPP_CLOSE_PAREN, NULL);
+      expr.value = error_mark_node;
+      return expr;
+    }
+
+  location_t close_loc = c_parser_peek_token (parser)->location;
+  if (!parens.require_close (parser))
+    {
+      expr.value = error_mark_node;
+      return expr;
+    }
+
+  expr.value = c_build_builtin_available (start_loc, close_loc, specs);
+  set_c_expr_source_range (&expr, start_loc, close_loc);
+  return expr;
+}
+
