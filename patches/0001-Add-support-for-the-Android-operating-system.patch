diff --git a/configure.ac b/configure.ac
index c5de225b0..0f189c942 100644
--- a/configure.ac
+++ b/configure.ac
@@ -3978,6 +3978,14 @@ if test -d ${srcdir}/gcc; then
 
   # Search for pre-installed headers if nothing else fits.
   FLAGS_FOR_TARGET=$FLAGS_FOR_TARGET' -isystem $(build_tooldir)/include -isystem $(build_tooldir)/sys-include'
+  
+  # Targets such as Android place all architecture-specific headers in a single
+  # include directory, organized into subdirectories named after the target triplet.
+  case "${target}" in
+    *linux-android*)
+        FLAGS_FOR_TARGET=$FLAGS_FOR_TARGET' -isystem $(build_tooldir)/include/'"${target_noncanonical}"
+      ;;
+  esac
 fi
 
 if test "x${use_gnu_ld}" = x &&
